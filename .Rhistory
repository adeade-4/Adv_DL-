from ucimlrepo import fetch_ucirepo
# fetch dataset
wine = fetch_ucirepo(id=109)
features = wine.data.features
targets = wine.data.targets
# Merge X and y into a single DataFrame
wine_data = pd.concat([features, targets], axis=1)
print(wine_data.info())
matrix_corr = wine_data.corr()
print(matrix_corr['class'].sort_values(ascending=False))
wine_features = wine_data.drop(["class"], axis = 1)
