reticulate::repl_python()
import pandas as pd
from ucimlrepo import fetch_ucirepo
# fetch dataset
wine = fetch_ucirepo(id=109)
features = wine.data.features
targets = wine.data.targets
# Merge X and y into a single DataFrame
wine_data = pd.concat([features, targets], axis=1)
print(wine_data.info())
matrix_corr = wine_data.corr()
print(matrix_corr['class'].sort_values(ascending=False))
import seaborn as sns
import matplotlib.pyplot as plt
plt.figure(figsize=(10, 8))
sns.heatmap(matrix_corr, annot=True, cmap=plt.cm.CMRmap_r)
plt.title("Correlation Heatmap")
plt.show()
def find_high_corr(data, max_corr):
column_corr = set()
corr_matrix = data.corr()
for i in range(len(corr_matrix.columns)):
for j in range(i):
if abs(corr_matrix.iloc[i,j]) > max_corr:
colname = corr_matrix.columns[i]
column_corr.add(colname)
return column_corr
corr_features = find_high_corr(wine_features, 0.8)
print(corr_features)
print(wine_data.info())
matrix_corr = wine_data.corr()
print(matrix_corr['class'].sort_values(ascending=False))
wine_features = wine_data.drop(["class"], axis = 1)
print(wine_features.head())
import seaborn as sns
import matplotlib.pyplot as plt
plt.figure(figsize=(10, 8))
sns.heatmap(matrix_corr, annot=True, cmap=plt.cm.CMRmap_r)
plt.title("Correlation Heatmap")
plt.show()
def find_high_corr(data, max_corr):
column_corr = set()
corr_matrix = data.corr()
for i in range(len(corr_matrix.columns)):
for j in range(i):
if abs(corr_matrix.iloc[i,j]) > max_corr:
colname = corr_matrix.columns[i]
column_corr.add(colname)
return column_corr
corr_features = find_high_corr(wine_features, 0.8)
print(corr_features)
print(wine_data.isna().sum())
features_melted = features.melt(var_name='wine_data', value_name='class')
# Create the boxplot
plt.figure(figsize=(10, 6))
sns.boxplot(
x='class',
y='wine_data',
data=features_melted,
orient='h',
showmeans=True,
palette='Set3',
meanprops={"marker": "o", "markerfacecolor": "black", "markeredgecolor": "black"}
)
# Add title and labels
plt.title('Boxplot of Features')
plt.xlabel('class')
plt.ylabel('wine_data')
# Show the plot
plt.tight_layout()
plt.show()
from sklearn.preprocessing import StandardScaler
scaler = StandardScaler()
scaled_data = scaler.fit_transform(features)
scaled_df = pd.DataFrame(scaled_data,columns=features.columns)
print(scaled_df.head(15))
from sklearn.model_selection import train_test_split
train_set_x, test_set_x, train_set_y, test_set_y = train_test_split(scaled_df,
targets, test_size=0.3,random_state=42)
print(len(test_set_x), len(train_set_x), len(train_set_y),len(test_set_y))
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, f1_score, classification_report, confusion_matrix
from sklearn.model_selection import cross_validate, GridSearchCV
import numpy as np
param_grids = {
'KNeighbors': {
'classifier': KNeighborsClassifier(),
'param_grid': {
'n_neighbors': [3, 5, 7, 10, 12],
}
}
}
test_accuracy_scores = []
test_f1_scores = []
print("----------- Evaluating on the Test Set -------------")
for name, model in param_grids.items():
print(f"Testing {name} model...")
grid_search = GridSearchCV(estimator=model['classifier'], param_grid=model['param_grid']
,scoring='accuracy', cv=3, n_jobs=-1)
grid_search.fit(train_set_x, train_set_y)
best_model = grid_search.best_estimator_
test_pred = best_model.predict(test_set_x)
test_accuracy = accuracy_score(test_set_y, test_pred)
test_f1 = f1_score(test_set_y, test_pred, average='weighted')
test_accuracy_scores.append(test_accuracy)
test_f1_scores.append(test_f1)
cv_results_df = pd.DataFrame(grid_search.cv_results_)
print(cv_results_df[['params', 'mean_test_score', 'std_test_score']])
print("--------------------------------------------")
print(f"Best Params for {name}: {grid_search.best_params_}")
print(f"Test Set Accuracy: {test_accuracy:.6f}")
print(f"Test Set F1-Score: {test_f1:.6f}")
print(classification_report(test_set_y, test_pred))
labels = np.unique(test_set_y)
cm_test = confusion_matrix(test_set_y, test_pred)
sns.heatmap(cm_test, annot=True, fmt="d", cmap="Blues",xticklabels=labels,
yticklabels=labels)
plt.xlabel('Predicted Labels')
plt.ylabel('Actual Labels')
plt.title(f"Test Set Confusion Matrix for {name}")
plt.show()
print("--------------------------------------------")
plt.figure(figsize=(10, 5))
x = np.arange(len(param_grids))
plt.bar(x - 0.2, test_accuracy_scores, width=0.4, label='Test Accuracy')
plt.bar(x + 0.2, test_f1_scores, width=0.4, label='Test F1-Score')
plt.xticks(x, param_grids.keys())
plt.ylabel('Scores')
plt.title('Test Set Performance (Accuracy and F1-Score)')
plt.legend()
plt.show()
data=pd.read_csv("C:/Users/Sijibomi/Documents/LTU/DS/housepricedata.csv")
print(data.info())
features_1=data.iloc[:,0:10].values
targets_1=data.iloc[:,10].values
from sklearn.preprocessing import StandardScaler
scaler = StandardScaler()
scaled_data_features = scaler.fit_transform(features_1)
scaled_df_features = pd.DataFrame(scaled_data_features,columns=data.columns[0:10])
print(scaled_df_features.head(15))
from sklearn.model_selection import train_test_split
X_train, X_val_and_test, Y_train, Y_val_and_test = train_test_split(scaled_df_features, targets_1, test_size=0.3)
X_val, X_test, Y_val, Y_test = train_test_split(X_val_and_test, Y_val_and_test, test_size=0.5)
print(X_train.shape, X_val.shape, X_test.shape, Y_train.shape, Y_val.shape, Y_test.shape)
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
model = Sequential()
model.add(Dense(40, activation="relu", input_shape=(10,)))
model.add(Dense(40, activation="relu"))
model.add(Dense(1, activation="linear"))
model.compile(optimizer="sgd",loss="mean_squared_error",metrics=["accuracy"])
history = model.fit(X_train,
Y_train,
batch_size=32,
epochs=100,
verbose=2,
validation_data=(X_val,Y_val))
